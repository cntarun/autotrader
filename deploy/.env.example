# Copy to deploy/.env (git-ignored). chmod 600 deploy/.env
# On a server prefer pulling these from AWS SSM / SOPS at boot (see docs/RUNBOOK.md).

# --- mode & safety --------------------------------------------------------------
KRONOS_MODE=paper                       # paper | live
# Live mode refuses to start unless this is exactly I_ACCEPT_REAL_MONEY_RISK
KRONOS_LIVE_CONFIRM=
# Absolute ceiling on risk.capital_cap (quote currency). Raise deliberately, never casually.
KRONOS_HARD_CAP=25
# Emergency: set to HALT (freeze) or FLATTEN (sell all, then freeze) and restart the bot
KRONOS_KILL=

# --- exchange (live only). Key must be: trade-only, NO withdrawals, IP-whitelisted,
# on a dedicated sub-account holding only the bot's capital.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=                  # only some exchanges (e.g. OKX, KuCoin)

# --- alerts (any subset) ----------------------------------------------------------
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=                             # free phone push: pick a long random topic name

# --- monitoring -------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=
KRONOS_IMAGE=ghcr.io/OWNER/kronos-autotrader:latest
